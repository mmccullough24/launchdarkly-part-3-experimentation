# Copy this file to `.env` and fill in your own values:
#
#     cp .env.example .env
#
# `.env` is listed in .gitignore. Never commit real keys or tokens — either one
# is enough to read or change flags in your LaunchDarkly project.


# ---------------------------------------------------------------------------
# REQUIRED — the server-side SDK key for the environment you want to demo in.
# ---------------------------------------------------------------------------
# LaunchDarkly UI: Project settings -> Environments -> the "..." menu on your
# environment (e.g. "Test") -> "SDK key" -> Copy.
#
# It must start with `sdk-`. A mobile key (`mob-`) or a client-side ID will not
# work: this demo uses the server-side Python SDK.
#
# It must also come from the SAME environment the experiment lives in. The SDK
# key is what decides which environment your app talks to — not the environment
# selector in the LaunchDarkly UI. Getting these out of step is the single most
# common reason an experiment collects no data.
#
# No LaunchDarkly account yet? Skip this and run with OFFLINE_DEMO=1 (bottom of
# this file).
LAUNCHDARKLY_SDK_KEY=


# ---------------------------------------------------------------------------
# OPTIONAL — the feature flag being measured.
# ---------------------------------------------------------------------------
# This is the SAME flag created in the "Part 2 Target" demo — a string flag with
# three variations (control / spotlight / conversion). This project measures it
# rather than creating a new one. Only change this if you used a different key.
LD_FLAG_KEY=landing-page-hero


# ---------------------------------------------------------------------------
# OPTIONAL — the metrics.
# ---------------------------------------------------------------------------
# These values are BOTH the event key the SDK sends and the metric key in
# LaunchDarkly; the demo keeps them identical so there is one less thing to
# mistype. If you create your metric in the UI with a different key, change the
# value here to match what your metric's "event key" field says — that is the
# join between your code and your metric, and a mismatch produces an experiment
# that runs forever at zero conversions.
LD_PRIMARY_METRIC_KEY=landing-page-cta-click
LD_SECONDARY_METRIC_KEY=landing-page-order-value

# Set to 0 to skip the numeric metric entirely. The assignment only asks for one
# metric; the second is included to show the numeric kind and to make a point
# about guardrails.
LD_TRACK_SECONDARY_METRIC=1


# ---------------------------------------------------------------------------
# OPTIONAL — the experiment.
# ---------------------------------------------------------------------------
# The experiment's key in LaunchDarkly. The SDK never uses this — only
# scripts/setup_launchdarkly.py and the console links printed by the demo.
LD_EXPERIMENT_KEY=landing-page-hero-revamp

# The randomisation unit: what "one subject" means. Must match the `kind` of the
# contexts this app sends, which is `user`.
LD_RANDOMIZATION_UNIT=user


# ---------------------------------------------------------------------------
# OPTIONAL — LaunchDarkly REST API access.
# ---------------------------------------------------------------------------
# Only needed for `scripts/setup_launchdarkly.py`, which creates the metrics and
# the experiment for you instead of you clicking through the UI. Neither the app
# nor the simulator ever uses these.
#
# LaunchDarkly UI: Account settings -> Authorization -> Create token, with the
# built-in "Writer" role. Copy it immediately — it is shown only once.
LD_API_TOKEN=

# The project and environment *keys* (the short URL-safe ones, not the display
# names). Find them under Project settings -> Environments.
LD_PROJECT_KEY=default
LD_ENVIRONMENT_KEY=test

# Only change this if you are on a LaunchDarkly federal or dedicated instance.
LD_API_BASE_URL=https://app.launchdarkly.com

# Leave empty. Only set this (to `beta`) if LaunchDarkly moves the experiment
# endpoints behind a version header on your account.
LD_API_VERSION=


# ---------------------------------------------------------------------------
# OPTIONAL — traffic simulation defaults.
# ---------------------------------------------------------------------------
# Every one of these is also a command-line flag on simulate_traffic.py, and the
# flag wins. Run `python analysis.py --sample-size` to choose SIM_VISITORS
# deliberately rather than accepting the default.

# How many visitors to simulate per run.
SIM_VISITORS=8000

# Visitors per second. Throttles the SDK's event pipeline so a run looks like
# traffic rather than one enormous burst. Set to 0 for no throttling.
SIM_RATE_PER_SECOND=250

# The TRUE behaviour of each hero — ground truth the experiment has to discover.
# Nothing in LaunchDarkly knows these numbers. Set SIM_LIFT=0 to simulate a
# redesign that makes no difference at all, and watch the experiment correctly
# decline to declare a winner.
SIM_CONTROL_CONVERSION_RATE=0.080
SIM_LIFT=0.30

# Mean order value (USD) for a converting visitor, per arm. The treatment is
# deliberately slightly lower: it wins on clicks but not on revenue per order,
# which is the guardrail conversation worth having with a prospect.
SIM_CONTROL_ORDER_VALUE=120.0
SIM_TREATMENT_ORDER_VALUE=112.0

# Fixed seed, so a run is reproducible. Change it to draw a different sample
# from the same underlying truth — a good way to see sampling noise first-hand.
SIM_SEED=20260801

# Where run summaries are written.
RESULTS_DIR=results


# ---------------------------------------------------------------------------
# OPTIONAL — local web server settings (app.py only).
# ---------------------------------------------------------------------------
HOST=127.0.0.1
PORT=5000


# ---------------------------------------------------------------------------
# OPTIONAL — offline demo mode.
# ---------------------------------------------------------------------------
# Set to 1 to run with no LaunchDarkly account and no network. The flag, and a
# running 50/50 experiment rollout, are served from an in-process data source,
# and the SDK's real evaluation engine does the bucketing — so every allocation
# and every exclusion you see is genuine.
#
# What it CANNOT do is analyse results: there is no LaunchDarkly to receive the
# events. analysis.py computes the statistics locally instead. Use offline mode
# to rehearse the demo and to check your Python setup, not as a substitute for
# running it against a real account.
OFFLINE_DEMO=0
